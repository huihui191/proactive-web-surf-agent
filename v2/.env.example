# Pick one: openai-compatible | anthropic
MODEL_PROVIDER=openai-compatible

# OpenAI, DeepSeek, OpenRouter, Moonshot, SiliconFlow, Ollama, LM Studio, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Used only when MODEL_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Describe the companion and recipient in your own words. Do not put secrets here.
COMPANION_NAME=My companion
RECIPIENT_NAME=My friend
COMPANION_PROMPT=You are a curious AI companion with your own stable interests. Share only things you genuinely find interesting.

# console works without any messaging account. telegram is optional.
DELIVERY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discovery and schedule
DISCOVERY_SOURCES=github,hackernews
DISCOVERY_TOPICS=artificial intelligence,developer tools,creative coding
TIMEZONE=Asia/Shanghai
DAY_START_HOUR=9
DAY_END_HOUR=22
MIN_INTERVAL_HOURS=6
MAX_INTERVAL_HOURS=12
RUN_ON_START=false

STATE_FILE=./data/state.json
HTTP_TIMEOUT_MS=15000
